# Not put on GitHub (also the list push_to_github.sh uses when it copies this folder into the repository).
# One plain pattern per line, no "!" lines: git and rsync both read this file.

# made on each machine
.venv/
__pycache__/
*.cache
.DS_Store
.claude/
Ultralytics/
logs/
results/
data/

# numbers measured on each machine (bash run.sh 1 / 3 make them again) and site-specific settings
metrics/
zones.json
*_preview.jpg

# personal work notes
PLAN.md

# recorded clips can show real people: only the made-up test clips (names starting with _) are shared
clips/[!_]*

# models trained in ~/Documents/YOLO: bring them with "bash run.sh import" (the pretrained ones are shared)
models/*_trained*

# generated from the code
*_code.pdf

# only used on the author's Mac to update the repository
push_to_github.sh
