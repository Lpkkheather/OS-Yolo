# Copy to .env (cp .env.example .env) and fill in — .env is never put on GitHub (.gitignore).
# Supabase project of OS-Yolo: Project Settings > Data API (URL) and Project Settings > API Keys (secret key).
# Empty = no Supabase: the counting still writes data/<date>.csv and MQTT as before.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
