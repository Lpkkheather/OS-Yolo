# ============================================================
# Backend .env — คัดลอกเป็น .env แล้วใส่ค่า (cp .env.example .env) · .env ไม่ขึ้น GitHub
# ============================================================

# พอร์ตของ Express + Socket.IO (Tailscale Funnel ชี้มาที่พอร์ตนี้)
PORT=4000

# แหล่งข้อมูลรายนาที: csv | supabase — ว่าง = supabase ถ้ามี SUPABASE_URL ไม่งั้น csv
DATA_SOURCE=

# Supabase ของ OS-Yolo: Project Settings > Data API (URL) · Project Settings > API Keys > secret key (sb_secret_...)
# secret key ใช้เฉพาะฝั่ง server — ห้ามใส่ใน dashboard หรือตัวแปร NEXT_PUBLIC_*
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# อ่านข้อมูลวันนี้ใหม่ทุกกี่วินาที (และทันทีที่ Pi ส่งนาทีใหม่ทาง MQTT)
SUPABASE_REFRESH_SECONDS=20
# เฉพาะกล้องนี้ (ว่าง = ทุกกล้อง)
SUPABASE_CAMERA=

# โหมด csv: โฟลเดอร์ข้อมูลของตัวนับ (relative จาก backend/ หรือ absolute)
YOLO_DATA_DIR=../YOLO_Pi/data
# โฟลเดอร์ YOLO_Pi (zones.json / zones_preview.jpg)
YOLO_ROOT_DIR=../YOLO_Pi

# MQTT broker: backend รันบน Pi = mqtt://localhost:1883 · ว่าง = ปิด MQTT (ไม่มีค่าสด / ภาพ)
MQTT_BROKER_URL=mqtt://localhost:1883

# เกณฑ์ของเหตุการณ์
MAX_PEOPLE=50
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=20
LOW_FPS_THRESHOLD=8

# CORS — โดเมนของ dashboard คั่นด้วย , (เช่น http://localhost:3000,https://os-yolo-dashboard.vercel.app)
FRONTEND_URL=http://localhost:3000

# ส่งข้อมูลทั้งหน้าให้ dashboard ทุกกี่วินาที
SOCKET_SYNC_SECONDS=3
