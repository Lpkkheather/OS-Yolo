# ============================================================
# Backend .env — ปรับค่าให้ตรงกับ environment จริง
# ============================================================

# พอร์ต Express server
PORT=4000

# Path ไปยัง YOLO_Pi/data/ (relative จาก backend/ หรือ absolute)
YOLO_DATA_DIR=/home/raspberrypi5user/OS-Yolo/YOLO_Pi/data

# Path ไปยัง YOLO_Pi/ root (สำหรับ zones_preview.jpg)
YOLO_ROOT_DIR=/home/raspberrypi5user/OS-Yolo/YOLO_Pi

# MQTT broker URL — ตั้งค่าเพื่อรับ real-time จาก YOLO_Pi (mosquitto บน Pi หรือ localhost)
MQTT_BROKER_URL=mqtt://localhost:1883

# Config การนับคน
MAX_PEOPLE=50
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=20
LOW_FPS_THRESHOLD=8

# CORS — origin ของ Next.js frontend
FRONTEND_URL=http://localhost:3000

# Socket.IO — ส่งข้อมูลทั้ง dashboard ให้ frontend ทุกกี่วินาที (3-5)
SOCKET_SYNC_SECONDS=3
